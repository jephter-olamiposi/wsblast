
use builtin;
use str;

set edit:completion:arg-completer[wsblast] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'wsblast'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'wsblast'= {
            cand -u 'Target WebSocket endpoint flag (alternative to positional argument)'
            cand --url 'Target WebSocket endpoint flag (alternative to positional argument)'
            cand -c 'Number of concurrent WebSocket connection workers'
            cand --connections 'Number of concurrent WebSocket connection workers'
            cand --ramp-rate 'Connection ramp rate in workers per second (0 = spawn all connections immediately)'
            cand -d 'Total test duration including the connection ramp (e.g., ''10s'', ''30s'', ''2m'', ''500ms'')'
            cand --duration 'Total test duration including the connection ramp (e.g., ''10s'', ''30s'', ''2m'', ''500ms'')'
            cand --stages 'Staged load profile instead of -c, -d and --ramp-rate: comma-separated DURATION:CONNECTIONS stages, each moving the connection count linearly from the previous target (starting at 0), e.g. ''30s:100,2m:100,30s:0'''
            cand --arrival-rate 'Start new sessions at this rate, per second, instead of holding -c connections: arrivals keep their schedule whether or not the server keeps up. Each session closes after --session-duration; -d sets the length of the run'
            cand --session-duration 'How long each --arrival-rate session stays connected, handshake included (e.g. ''30s'')'
            cand --max-connections 'With --arrival-rate, the most sessions open at once; arrivals while this many are open are skipped and counted'
            cand -n 'Maximum total messages to send across all workers (optional limit)'
            cand --requests 'Maximum total messages to send across all workers (optional limit)'
            cand -r 'Message rate per connection per second (0 = unthrottled / maximum possible)'
            cand --rate 'Message rate per connection per second (0 = unthrottled / maximum possible)'
            cand -p 'Inline message payload to send (supports {{timestamp}}, {{worker_id}}, {{seq}} and, with --data, {{data.COLUMN}})'
            cand --payload 'Inline message payload to send (supports {{timestamp}}, {{worker_id}}, {{seq}} and, with --data, {{data.COLUMN}})'
            cand --payload-file 'Path to a file containing the message payload'
            cand --data 'Per-connection test data: a CSV file with a header row, or JSON Lines. Connection N uses row N (wrapping round); payloads and -H values read its columns as {{data.COLUMN}}'
            cand -H 'Custom HTTP header to include in the WebSocket handshake (can be specified multiple times; the value may hold {{worker_id}} and {{data.COLUMN}})'
            cand --header 'Custom HTTP header to include in the WebSocket handshake (can be specified multiple times; the value may hold {{worker_id}} and {{data.COLUMN}})'
            cand --subprotocol 'Optional WebSocket subprotocol to request during handshake'
            cand --source-ip 'Local addresses connections bind in turn, comma-separated or repeated, so one machine can open more connections to one target than one address''s ephemeral ports allow (e.g. ''10.0.0.5,10.0.0.6'')'
            cand --mode 'Load testing execution mode'
            cand --connect-timeout 'Connection handshake timeout (e.g., ''5s'', ''2000ms'')'
            cand --message-timeout 'Per-message response timeout in echo mode (e.g., ''5s'', ''1000ms'')'
            cand --match 'Echo reply matching: first (default: the first data frame after a send is the reply), exact, or json:POINTER (an RFC 6901 pointer such as json:/seq)'
            cand --expect 'Check every echo reply: json:/pointer (a value is there), json:/pointer=VALUE (it equals VALUE) or contains:TEXT. A reply that fails counts as a check_failed error'
            cand --ping-interval 'Periodic ping heartbeat interval (e.g., ''10s'', ''0s'' to disable)'
            cand --max-p50 'SLO threshold: Maximum acceptable p50 round-trip latency (e.g., ''10ms'', ''500us'')'
            cand --max-p95 'SLO threshold: Maximum acceptable p95 round-trip latency (e.g., ''50ms'', ''20ms'')'
            cand --max-p99 'SLO threshold: Maximum acceptable p99 round-trip latency (e.g., ''100ms'', ''50ms'')'
            cand --max-p999 'SLO threshold: Maximum acceptable p99.9 round-trip latency (e.g., ''250ms'')'
            cand --max-error-rate 'SLO threshold: Maximum acceptable error rate fraction (e.g., ''0.01'' for 1%, ''0.001'' for 0.1%)'
            cand --min-throughput 'SLO threshold: Minimum required message throughput (messages/sec)'
            cand --max-generator-lag 'SLO threshold: Maximum p99 wake-up lag of the load generator itself (e.g. ''20ms''); a breach means the latency numbers include client-side delay'
            cand --auth-type 'Authentication type'
            cand --auth-token 'Static token for auth (used with --auth-type static)'
            cand --auth-token-cmd 'Command whose trimmed stdout is the token or API key, run through the platform shell before the run (replaces --auth-token or --auth-apikey)'
            cand --auth-token-cmd-timeout 'Time allowed for each run of --auth-token-cmd [default: 30s]'
            cand --auth-token-refresh 'Re-run --auth-token-cmd every DURATION during the run; new handshakes use the latest token'
            cand --auth-header 'Header that carries the token (used with every --auth-type except apikey)'
            cand --auth-apikey 'API Key (used with --auth-type apikey)'
            cand --auth-apikey-header 'API Key header name (used with --auth-type apikey)'
            cand --auth-jwt-alg 'JWT signing algorithm (used with --auth-type jwt) [default: HS256]'
            cand --auth-jwt-key 'File with the JWT signing key: the secret bytes for HS*, a PEM private key for RS256 and ES256; or set WSBLAST_JWT_KEY_FILE'
            cand --auth-jwt-claims 'JSON object of claims added to every JWT (e.g. ''{"sub":"loadtest","aud":"ws"}'')'
            cand --auth-jwt-ttl 'JWT lifetime, which sets iat, nbf and exp; tokens are re-signed before they expire [default: 5m]'
            cand --auth-jwt-kid 'Key ID put in the JWT header as kid, for servers that look the verification key up in a JWKS'
            cand --auth-oauth2-token-url 'OAuth2 token endpoint for the client-credentials grant (used with --auth-type oauth2)'
            cand --auth-oauth2-client-id 'OAuth2 client id (used with --auth-type oauth2)'
            cand --auth-oauth2-client-secret-file 'File with the OAuth2 client secret; or set WSBLAST_OAUTH2_CLIENT_SECRET'
            cand --auth-oauth2-scope 'Scope requested with the OAuth2 token (space-separated)'
            cand --auth-oauth2-audience 'Audience parameter sent with the OAuth2 token request, for servers that require one'
            cand --graphql-ws-operation-name 'GraphQL WS operation name'
            cand --graphql-ws-operation 'GraphQL WS operation (query/mutation/subscription)'
            cand --graphql-ws-variables 'GraphQL WS variables (JSON)'
            cand --graphql-ws-extensions 'GraphQL WS extensions (JSON)'
            cand --sio-event 'Socket.IO event each message is emitted as (--mode socketio)'
            cand --sio-namespace 'Socket.IO namespace to connect to (--mode socketio), ''/'' by default'
            cand --sio-auth 'JSON object sent with the Socket.IO namespace connect, as a client''s `auth` option (--mode socketio); a template filled in per connection'
            cand --sio-version 'Socket.IO server version (--mode socketio): 2 for Socket.IO 2 servers (Engine.IO 3), 3 or 4 for later ones [default: 4]'
            cand --format 'Output report format'
            cand --compare 'Compare two JSON reports for regression detection (--format text, json, markdown or html)'
            cand --compare-threshold 'Regression threshold percentage (default: 10%)'
            cand --compare-window 'Restrict the time-series metrics of --compare to START..END of each run (e.g., ''10s..50s'', ''10s..'', ''..50s'')'
            cand --capture 'Record every data frame and connection event to FILE as JSON lines (see METHODOLOGY.md)'
            cand --capture-limit 'Maximum records --capture writes; later ones are dropped and counted (0 = unlimited)'
            cand --chaos-delay 'Chaos: pause DURATION, plus up to JITTER drawn uniformly, before every data send (e.g. ''5ms'' or ''5ms:20ms'')'
            cand --chaos-drop 'Chaos: skip this percentage (0 to 100) of data sends; they are counted as dropped, not as sent'
            cand --chaos-corrupt 'Chaos: change one byte of the payload of this percentage (0 to 100) of data sends; echo replies are still matched and timed'
            cand --chaos-close 'Chaos: close the connection after this percentage (0 to 100) of replies, or of sends in stream mode; the worker reconnects, and closes are not errors'
            cand --chaos-close-mode 'How --chaos-close ends a connection'
            cand --chaos-read-pause 'Chaos: a slow consumer; after reading each data frame, pause DURATION, plus up to JITTER drawn uniformly, before reading the next (e.g. ''50ms'' or ''50ms:20ms''); works in every mode'
            cand --chaos-seed 'Chaos: seed of every chaos decision, to repeat a run''s faults [default: picked per run and shown in the report]'
            cand -o 'Write the report to FILE in the --format format; the terminal then shows the text summary'
            cand --output 'Write the report to FILE in the --format format; the terminal then shows the text summary'
            cand --prometheus-listen 'Serve live metrics at http://ADDR/metrics in the Prometheus text format while the run lasts (e.g. ''127.0.0.1:9464''; port 0 picks a free port)'
            cand --otel-endpoint 'Export live metrics over OTLP/HTTP with protobuf bodies to this base URL, e.g. ''http://localhost:4318'' (needs the otel feature)'
            cand --otel-interval 'How often metrics are exported over OTLP; the final values are also exported when the run ends'
            cand --otel-service-name 'OpenTelemetry service.name resource attribute [default: $OTEL_SERVICE_NAME, else wsblast]'
            cand --scenario 'Path to scenario YAML file defining multi-phase test (conflicts with individual flags)'
            cand --phase 'Run only a specific phase from the scenario by name'
            cand --agents 'Generate the load on these agents (started with `wsblast agent`) instead of locally; comma-separated HOST:PORT, ws://HOST:PORT or wss://HOST:PORT'
            cand --agent-token 'Token the agents were started with [default: $WSBLAST_AGENT_TOKEN]'
            cand --agent-timeout 'Time the agents get to become ready before the start, and to send their results after the end of the run'
            cand --agent-ca 'PEM file of CA certificates to trust for wss:// agents, in addition to the platform''s roots'
            cand --binary 'Send payload as WebSocket binary frames instead of text frames'
            cand --compression 'Offer permessage-deflate compression on every handshake, as browsers do; the report shows how many servers agreed and the bytes saved'
            cand --auth-jwt-per-connection 'Sign a fresh JWT with a unique jti for every connection attempt instead of sharing one token'
            cand --fail-on-regression 'Fail on regression (exit code 2)'
            cand --tui 'Launch interactive terminal dashboard (TUI)'
            cand --no-progress 'Suppress interactive progress bar (recommended for non-interactive CI/CD runners)'
            cand --no-reconnect 'End a connection''s worker after a timeout, I/O error or server close instead of reconnecting with backoff'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand -V 'Print version'
            cand --version 'Print version'
            cand mock 'Run a local WebSocket test server: echo with optional delay, jitter, stalls, rejections and closes, or replay of a capture file'
            cand agent 'Run a load agent that generates load for a coordinator (`wsblast URL --agents ...`), one test at a time'
            cand render 'Render a saved JSON report (from --format json) or comparison (from --compare --format json) as HTML, Markdown or text without running a test'
        }
        &'wsblast;mock'= {
            cand --listen 'Address to listen on (host:port; port 0 picks a free port)'
            cand --delay 'Hold every reply for this long after its request arrived (e.g. ''20ms'')'
            cand --jitter 'Add a uniformly distributed extra delay between 0 and this to every reply'
            cand --close-after 'Close each connection with code 1000 after it sent N replies'
            cand --reject-ratio 'Answer this fraction (0.0 to 1.0) of upgrade requests with HTTP 503'
            cand --stall-every 'Stop replying on every connection at each multiple of this period (needs --stall-for)'
            cand --stall-for 'How long each stall lasts; shorter than --stall-every'
            cand --replay 'Instead of echoing, send each connection the frames a --capture file recorded as received, with their timing'
            cand --rules 'Answer frames as a YAML rules file says: match by text or JSON field, reply from templates, delay or close'
            cand --tls-cert 'PEM certificate chain to serve wss:// instead of ws:// (clients must trust it, e.g. with SSL_CERT_FILE)'
            cand --tls-key 'PEM private key for --tls-cert'
            cand --socketio 'Speak Socket.IO: accept any namespace, acknowledge every event that asks for an ack with its arguments, echo the others, and ping every 25s (Engine.IO 3 clients ping instead)'
            cand --compression 'Accept permessage-deflate when a client offers it: inflate its messages and compress the replies'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'wsblast;agent'= {
            cand --listen 'Address to accept coordinators on (host:port, e.g. ''0.0.0.0:7700''; port 0 picks a free port)'
            cand --token 'Token coordinators must present, at least 16 characters; required, here or in WSBLAST_AGENT_TOKEN'
            cand --tls-cert 'PEM certificate chain to serve the control channel over TLS (wss://)'
            cand --tls-key 'PEM private key for --tls-cert'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'wsblast;render'= {
            cand --format 'Format to render'
            cand -o 'Write the rendered report to FILE instead of stdout'
            cand --output 'Write the rendered report to FILE instead of stdout'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
    ]
    $completions[$command]
}
